.installed.cfg
*.egg

# Node / Frontend Build Cache
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Test, Coverage and Temporary Screenshots
.pytest_cache/
playwright-report/
test-results/
.playwright/
temp/
tmp/
